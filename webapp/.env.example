# Example environment for running the web + worker locally
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Optional: set a base output directory (default is per-job tempfile)
# BASE_OUTPUT_DIR=/data/jobs

# Authentication / encryption
# Set a long, random value here in production
JWT_SECRET=change-me-in-production
FERNET_KEY=replace-with-base64-fernet-key

# Database (sqlite by default)
DATABASE_URL=sqlite:///./webapp.db
